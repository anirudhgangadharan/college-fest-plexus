---
import {registrationMessage} from '../lib/registration.mjs';
const {registration,label}=Astro.props;
const url=registration?.registrationUrl;
---
{url?<a class="btn gold" href={url}>{label||'Register on Google Forms'}</a>:<span class="btn off" role="note" aria-disabled="true">{registrationMessage(registration)}</span>}
