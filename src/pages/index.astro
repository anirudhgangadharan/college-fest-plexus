---
import Base from '../layouts/Base.astro';
import f from '../content/festival.json';
import events from '../content/events.json';
const cats=[['workshop','Workshops','The art of clinical practice','Eight hands-on workshops in four combo packs.','/events/#workshop','/art/16.webp'],['academic','Academic Events','The pursuit of knowledge','Papers, posters, clinical cases and the medical quiz.','/events/#academic','/art/events/research-paper-presentation-800.webp'],['cultural','The Cultural Carnival','Dance, song and talent','Solo Dance, Duet & Group Dance, Solo Singing and Medicos Got Talent.','/events/#cultural','/art/events/duet-group-dance-800.webp'],['online','Online competitions','Memes, photographs, reels','Enter from anywhere. Free registration.','/events/#online','/brochure/online-photo.webp']];
---
<Base><section class="hero"><div class="hero-in"><p class="eyebrow">{f.subtitle}</p><h1>PLEXUS <span>'27</span></h1><p class="blend">{f.tagline}</p><p class="where">{f.institutionName}</p><div class="chips"><span>6 · 7 · 8 January 2027</span><span>Workshops</span><span>Academics</span><span>Culturals</span></div><div class="cta"><a class="btn gold" href="/register/" data-register>Register Now</a><a class="btn ghost" href="/events/">Explore Events</a></div></div><img class="hero-emblem" src="/brochure/emblem.webp" alt="Anatomical emblem of Plexus: half skull, half brain" width="240" height="219"/></section>
<section class="band"><div class="count"><b>3</b> days</div><div class="count"><b>8</b> workshops</div><div class="count"><b>4</b> academic events</div><div class="count"><b>4</b> cultural + 3 online</div></section>
<section class="wrap" id="about"><p class="eyebrow">The architecture of Plexus</p><h2>A convergence of ideas</h2><div class="two"><p class="lead">More than just a conference, PLEXUS is a vibrant three-day celebration of knowledge, creativity and talent, where curiosity meets discovery, ideas transcend boundaries and the future of medicine takes shape.</p><p>Undergraduate medical students, distinguished academicians, eminent clinicians and emerging researchers meet for hands-on workshops, panel discussions, interactive symposia, academic competitions, quizzes, research-oriented activities and spectacular cultural performances.</p></div></section>
<section class="wrap"><p class="eyebrow">Choose your pursuit</p><h2>What is on at Plexus</h2><div class="cat-grid">{cats.map(([k,t,s,d,h,img])=><a class="cat" href={h}><img src={img} alt="" loading="lazy" width="600" height="700"/><div><p class="eyebrow">{s}</p><h3>{t}</h3><p>{d}</p><span>Explore →</span></div></a>)}</div></section>
<section class="wrap fee-strip"><div><p class="eyebrow">Registration</p><h2>Delegate Pass <em>₹500</em></h2><p>Workshops, scientific sessions, guest lectures, cultural events, meals and the delegate kit. Cultural-only pass ₹200. Workshop combo ₹200 early bird until 12 December, ₹300 after.</p><div class="cta"><a class="btn gold" href="/register/">Register for Plexus</a></div></div><div class="plain"><p class="eyebrow">Explore the programme</p><h3>Find your event</h3><p>Browse workshops, academic events, cultural events and online competitions.</p><a class="btn ghost" href="/events/">Explore Events</a></div></section></Base>
