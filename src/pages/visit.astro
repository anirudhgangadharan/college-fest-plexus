---
import Base from '../layouts/Base.astro';
import f from '../content/festival.json';
const places=[['Heritage & architecture',[['Veeranarayana Temple','veeranarayana','A historic temple associated with the Kannada poet Kumaravyasa.'],['Trikuteshwara Temple','trikuteshwara','A magnificent Chalukyan temple known for intricate stone carvings.'],['Lakkundi','lakkundi','Ancient temples, sculptures and historic stepwells.'],['Doddabasappa Temple, Dambal','doddabasappa','An architectural marvel famous for its star-shaped design.']]],['Nature & leisure',[['Magadi Bird Sanctuary','magadi','A peaceful birdwatching spot, known for migratory birds in winter.'],['Kappatagudda Hills','kappatagudda','Scenic hill ranges, lush landscapes and panoramic views.'],['Gadag Zoo, Binkadakatti','gadag-zoo','A relaxed outing with friends.'],['Bhishma Kere','basaveshwara','A lakeside spot with the Basaveshwara statue and park.']]]];
---
<Base title="Visit Gadag · Plexus '27"><section class="wrap pagehead"><p class="eyebrow">Chart your course to Plexus</p><h1>How to reach</h1><p class="lead">{f.institutionName}<br/>{f.address}</p></section>
<section class="wrap visit-art" aria-label="Illustrations from the Plexus brochure"><img src="/brochure/reach-building.webp" alt="Vintage architectural illustration from the How to Reach brochure page" width="1024" height="1024"/><img src="/brochure/basaveshwara.webp" alt="Basaveshwara statue, as illustrated in the brochure" width="1194" height="1599"/></section>
<section class="wrap reach"><article><p class="eyebrow">By rail</p><h3>Gadag Junction</h3><p>8 km</p></article><article><p class="eyebrow">By road</p><h3>Gadag New Bus Stand</h3><p>8 km</p></article><article><p class="eyebrow">By air</p><h3>Hubballi Airport</h3><p>64 km</p></article></section>
<section class="wrap"><p class="note">{f.accommodation}</p></section>
{places.map(([g,l])=><section class="wrap"><p class="eyebrow">Discover Gadag · Karnataka 582103</p><h2>{g}</h2><div class="cards sm">{l.map(([t,img,d])=><div class="plain place"><img src={'/brochure/'+img+'.webp'} alt={t} loading="lazy" width="800" height="600"/><h3>{t}</h3><p>{d}</p></div>)}</div></section>)}</Base>
