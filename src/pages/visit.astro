---
import Base from '../layouts/Base.astro';
import f from '../content/festival.json';
const places=[['Heritage & architecture',[['Veeranarayana Temple','A historic temple associated with the Kannada poet Kumaravyasa.'],['Trikuteshwara Temple','A magnificent Chalukyan temple known for intricate stone carvings.'],['Lakkundi','Ancient temples, sculptures and historic stepwells.'],['Doddabasappa Temple, Dambal','An architectural marvel famous for its star-shaped design.']]],['Nature & leisure',[['Magadi Bird Sanctuary','A peaceful birdwatching spot, known for migratory birds in winter.'],['Kappatagudda Hills','Scenic hill ranges, lush landscapes and panoramic views.'],['Gadag Zoo, Binkadakatti','A relaxed outing with friends.'],['Bhishma Kere','A lakeside spot with the Basaveshwara statue and park.']]]];
---
<Base title="Visit Gadag · Plexus '27"><section class="wrap pagehead"><p class="eyebrow">Chart your course to Plexus</p><h1>How to reach</h1><p class="lead">{f.institutionName}<br/>{f.address}</p></section>
<section class="wrap reach"><article><p class="eyebrow">By rail</p><h3>Gadag Junction</h3><p>8 km</p></article><article><p class="eyebrow">By road</p><h3>Gadag New Bus Stand</h3><p>8 km</p></article><article><p class="eyebrow">By air</p><h3>Hubballi Airport</h3><p>64 km</p></article></section>
<section class="wrap"><p class="note">{f.accommodation}</p></section>
{places.map(([g,l])=><section class="wrap"><p class="eyebrow">Discover Gadag · Karnataka 582103</p><h2>{g}</h2><div class="cards sm">{l.map(([t,d])=><div class="plain"><h3>{t}</h3><p>{d}</p></div>)}</div></section>)}</Base>
