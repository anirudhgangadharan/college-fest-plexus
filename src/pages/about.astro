---
import Base from '../layouts/Base.astro';
import f from '../content/festival.json';
import people from '../content/people.json';
---
<Base title="About · Plexus '27"><section class="wrap pagehead"><p class="eyebrow">Our institute · our people</p><h1>About Plexus</h1><p class="lead">Plexus '27 is a state level undergraduate conference hosted by {f.institutionName}. It brings together students, academicians and clinicians across {f.date}.</p></section>
<section class="wrap two"><div><p class="eyebrow">Our institute</p><h2>Shaping knowledge. Inspiring excellence. Advancing healthcare.</h2><p>K. H. Patil Institute of Medical Sciences, Gadag, is committed to nurturing competent, compassionate and socially responsible medical graduates through quality medical education, comprehensive clinical training and academic excellence.</p></div><img class="frame-img" src="/brochure/institute.webp" alt="Illustration of the institute building" width="1000" height="300" loading="lazy"/></section>
<section class="wrap director"><figure class="frame oval"><img src="/brochure/director.webp" alt="Dr. Basavaraj P. Bommanahalli" width="520" height="520" loading="lazy"/></figure><div><p class="eyebrow">From the Director's desk</p><h2>Dear colleagues and future medical leaders,</h2><p>It gives me immense pleasure to invite you to PLEXUS 2027, the State-Level Undergraduate Medical Conference hosted by K H Patil Institute of Medical Sciences, Gadag. Envisioned as a platform for academic excellence, innovation and collaboration, PLEXUS brings together aspiring medical professionals through engaging workshops, quizzes, competitions and interactive learning experiences.</p><p>I encourage you to seize this opportunity to expand your knowledge, enhance your clinical skills and connect with fellow medical students and distinguished academicians. We look forward to welcoming you to PLEXUS 2027!</p><p class="sign"><b>{people.director.name}</b><br/>{people.director.role}</p></div></section>
<section class="wrap"><p class="eyebrow">Organizing committee</p><h2>The people behind Plexus</h2><div class="chairs">{people.chairs.map(p=><figure class="person"><div class="frame rect ph" role="img" aria-label={'Photo of '+p.name+' to be added'}><span>Photo<br/>coming soon</span></div><figcaption><small>{p.role}</small><b>{p.name}</b><span>{p.detail}</span></figcaption></figure>)}</div>
{people.committees.map(c=><><h3 class="sub">{c.committee}</h3><div class="members">{c.members.map(p=><figure class="person"><div class="frame oval ph" role="img" aria-label={'Photo of '+p.name+' to be added'}><span>Photo<br/>coming soon</span></div><figcaption><b>{p.name}</b><span>{p.role}</span></figcaption></figure>)}</div></>)}
<h3 class="sub">Students Union 2026-27 &amp; the Agneya Batch of 2023</h3><div class="members"><figure class="person"><div class="frame rect ph wide" role="img" aria-label="Group photo to be added"><span>Group photo coming soon</span></div><figcaption><b>Organizing Batch 2026-27</b><span>Agneya Batch of 2023 · Forged in Fire, Forever United</span></figcaption></figure></div></section></Base>
