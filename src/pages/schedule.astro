---
import Base from '../layouts/Base.astro';
import sched from '../content/schedule.json';
---
<Base title="Schedule · Plexus '27"><section class="wrap pagehead"><p class="eyebrow">5, 6 &amp; 7 January 2027</p><h1>Schedule</h1><p class="lead">Day one is hands-on, day two is academic, day three is the celebration.</p></section>
{sched.map(d=><section class="wrap day"><div class="day-h"><p class="daynum">Day {d.day}</p><h2>{d.title}</h2><p>{d.date} · {d.sub}</p></div><ol class="slots">{d.slots.map(([t,w])=><li><time>{t}</time><span>{w}</span></li>)}</ol></section>)}
<section class="wrap"><p class="note">Timings follow the brochure. Workshop combos, morning and afternoon sessions are listed on each <a href="/events/#workshop">workshop page</a>.</p></section></Base>
