---
import Base from '../../layouts/Base.astro';
import events from '../../content/events.json';
import combos from '../../content/workshop-combos.json';
const groups=[['workshop','Workshops','The art of clinical practice'],['academic','Academic Events','The pursuit of knowledge'],['cultural','The Cultural Carnival','An evening celebrating talent, art and culture'],['online','Online competitions','Submit from anywhere']];
const img=e=>e.art?`/art/${e.art}.webp`:e.category==='online'?`/brochure/${e.img}.webp`:'/brochure/emblem.webp';
---
<Base title="Events · Plexus '27"><section class="wrap pagehead"><p class="eyebrow">The programme</p><h1>Events</h1><p class="lead">Pick a track. Every event has its own rules, prizes and organiser contacts.</p><nav class="jump" aria-label="Jump to track">{groups.map(([k,t])=><a href={'#'+k}>{t.split(' · ')[0]}</a>)}</nav></section>
{groups.map(([k,t,s])=><section class="wrap" id={k}><p class="eyebrow">{s}</p><h2>{t}</h2><div class="cards">{k==='workshop'?combos.map((combo,index)=><a class="card" href={'/events/'+combo.slug+'/'}><img src={'/art/'+events.find(e=>e.slug===combo.eventSlugs[0]).art+'.webp'} alt="" loading="lazy" width="400" height="500"/><div><p class="eyebrow">6 January 2027 · Combo Pack {String(index+1).padStart(2,'0')}</p><h3>{combo.title}</h3><span>View combo →</span></div></a>):events.filter(e=>e.category===k).map(e=><a class={'card '+(e.art||e.category==='online'?'':'noart')} href={'/events/'+e.slug+'/'}><img src={img(e)} alt="" loading="lazy" width="400" height="500"/><div><p class="eyebrow">{e.when}</p><h3>{e.title}</h3><p>{e.subtitle}</p><span>View event →</span></div></a>)}</div></section>)}</Base>
