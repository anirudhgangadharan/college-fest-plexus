---
import Base from '../../layouts/Base.astro';
import events from '../../content/events.json';
---
<Base title="Explore events"><section><p class="eyebrow">THE PROGRAMME / PROVISIONAL</p><h1>Find your<br/><em>next discovery.</em></h1><p class="intro">Clinical skills. New perspectives. A shared pursuit of knowledge.</p><div class="filters" hidden><label>Explore by track <select id="track"><option value="all">All events</option><option value="workshop">Workshops</option><option value="academic">Academic arena</option></select></label><button id="reset">Clear filters</button><p id="count" aria-live="polite"></p></div><div class="cards">{events.map(e=><article class="card" data-track={e.track}><a href={'/events/'+e.slug+'/'}><img src={'/art/'+e.art+'.webp'} alt="" width="800" height="962" loading="lazy"/><p class="eyebrow">{e.track} · PROVISIONAL</p><h2>{e.title}</h2><p>{e.subtitle}</p><span>View event ↗</span></a></article>)}</div></section></Base><script>const controls=document.querySelector('.filters');controls?.removeAttribute('hidden');const select=document.querySelector<HTMLSelectElement>('#track');function filter(){let n=0;document.querySelectorAll<HTMLElement>('[data-track]').forEach(el=>{el.hidden=select?.value!=='all'&&el.dataset.track!==select?.value;if(!el.hidden)n++});document.querySelector('#count')!.textContent=n+' events';}if(select){const initial=new URLSearchParams(location.search).get('track');if(initial==='academic'||initial==='workshop')select.value=initial;select.addEventListener('change',filter);document.querySelector('#reset')?.addEventListener('click',()=>{select.value='all';filter()});filter();}</script>