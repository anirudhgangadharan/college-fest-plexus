---
import Base from '../../layouts/Base.astro';
import FormButton from '../../components/FormButton.astro';
import events from '../../content/events.json';
import reg from '../../content/registration.json';
export function getStaticPaths(){return events.map(event=>({params:{slug:event.slug},props:{event}}))}
const {event:e}=Astro.props;
const img=e.art?`/art/${e.art}.webp`:e.img?`/brochure/${e.img}.webp`:null;
const form=reg.forms[e.form];
---
<Base title={e.title+' · Plexus \'27'} desc={e.subtitle+'. '+e.tagline}><section class="wrap detail"><div class="d-main"><a class="back" href="/events/">← All events</a><p class="eyebrow">{e.subtitle}</p><h1>{e.title}</h1><p class="tag">“{e.tagline}”</p><p class="lead">{e.about}</p>
{e.pack&&<p class="note"><b>Combo Pack {String(e.pack).padStart(2,'0')}</b> · {e.session}. Workshops are booked as a combo; one student can register for each combo only.</p>}
<h2 class="h3">{e.leadIn}</h2><ul class="list">{e.items.map(i=><li>{i}</li>)}</ul>
{e.rules&&e.rules.length>0&&<><h2 class="h3">Integrity</h2><ul class="list">{e.rules.map(i=><li>{i}</li>)}</ul></>}
{e.contacts&&e.contacts.length>0&&<><h2 class="h3">Contact for queries</h2><ul class="contacts">{e.contacts.map(c=><li><span>{c.name}</span><a href={'tel:'+c.phone.replace(/\s/g,'')}>{c.phone}</a></li>)}</ul></>}</div>
<aside class="d-side">{img&&<img src={img} alt={'Illustration for '+e.title} width="600" height="700"/>}<dl><dt>When</dt><dd>{e.when}</dd><dt>Fee</dt><dd>{e.fee}</dd>{e.prize&&<><dt>Prizes</dt><dd>{e.prize}</dd></>}<dt>Venue</dt><dd>K. H. Patil Institute of Medical Sciences, Gadag</dd></dl><div class="reg-box"><p class="eyebrow">{form.label}</p><FormButton form={e.form}/><p class="small">One Google Form covers this whole category.</p></div></aside></section></Base>
