---
import Base from '../layouts/Base.astro';
import groups from '../content/registration-events.json';
import events from '../content/events.json';
import {formatEventDate,validateRegistrationGroups,registrationMessage} from '../lib/registration.mjs';
validateRegistrationGroups(groups,events);
---
<Base title="Register for PLEXUS ’27" desc="Explore workshop combos, academics, culturals and online event registration for PLEXUS ’27.">
  <div class="registration-directory">
    <div class="legacy-registration-links"><span id="delegate"></span><span id="presentations"></span><span id="quiz"></span></div>
    <section class="registration-intro" aria-labelledby="registration-heading">
      <h1 id="registration-heading">Register for PLEXUS ’27</h1>
      <span class="registration-rule" aria-hidden="true"></span>
      <p>Select an event below to view its details and registration status.</p>
    </section>
    {groups.map(group=><section class:list={['registration-group',{'online-group':group.id==='online'}]} id={group.id} aria-labelledby={'heading-'+group.id}>
      <h2 id={'heading-'+group.id}><span>{group.title}</span></h2>
      <div class="registration-grid">
        {group.items.map(item=><article class="registration-card" id={item.id}>
          <h3>{item.title}</h3>
          <time datetime={group.date}>{formatEventDate(group.date,true)}</time>
          <div class="registration-actions">
            {item.registrationUrl ? <a class="register-action" href={item.registrationUrl}>Register Now<span class="sr-only"> for {item.title} on Google Forms</span></a> : <button class="register-action" type="button" disabled aria-label={'Register Now for '+item.title+' — '+registrationMessage(item)} title={registrationMessage(item)}>Register Now</button>}
            {item.detailsUrl ? <a class="details-action" href={item.detailsUrl}>View Details<span class="sr-only"> for {item.title}</span></a> : <button class="details-action" type="button" disabled aria-label={'View Details for '+item.title+' — link coming soon'} title="Details link coming soon">View Details</button>}
          </div>
          {!item.registrationUrl && <p class="small" role="note">{registrationMessage(item)}</p>}
        </article>)}
      </div>
    </section>)}
    <p class="registration-note">Registration continues on Google Forms for your selected event or workshop combo. Basic Life Support + Heart Sounds and Medical Quiz registration are temporarily unavailable while their form links are being repaired.</p>
  </div>
</Base>
